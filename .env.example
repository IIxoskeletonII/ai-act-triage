# The web app (python app.py) reads this file; variables already set in the shell take precedence.
# The command-line agent and the eval harness do not read it: export the variables in the shell for those.
# The baseline does not need any of this.

ANTHROPIC_API_KEY=your-key-here

# Which model the agent uses. Any Pydantic AI model string works; swapping provider is one line.
# Default is a Claude model. Change the id if your account uses a different alias.
MODEL=anthropic:claude-sonnet-5-5
